# AgentKit — Variables de entorno
# Generado por AgentKit — NO subir a GitHub

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Proveedor de WhatsApp
WHATSAPP_PROVIDER=twilio  # twilio | meta

# --- Si WHATSAPP_PROVIDER=twilio ---
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=...

# --- Si WHATSAPP_PROVIDER=meta ---
# META_ACCESS_TOKEN=...
# META_PHONE_NUMBER_ID=...
# META_VERIFY_TOKEN=agentkit-verify

# Integracion Odoo (REQUERIDO para SPARMAP)
ODOO_ENABLED=true
ODOO_URL=https://sparmap.odoo.com
ODOO_DB=nombre_base_datos
ODOO_USERNAME=api-agente@sparmap.com
ODOO_API_KEY=...

# Servidor
PORT=8000
ENVIRONMENT=development

# Base de datos
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# DATABASE_URL=postgresql+asyncpg://...   # producción Railway
